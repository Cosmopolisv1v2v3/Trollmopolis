# ============================================================
# Cosmopolis Guild System — variables de entorno
# Copiá este archivo a .env y completalo.
# ============================================================

# --- Discord ---
# Token del bot (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=
# Discord OAuth client secret (OAuth2 -> General) — para login en la web
DISCORD_CLIENT_SECRET=
# ID NUMÉRICO de tu servidor para registrar comandos al instante en desarrollo.
# Vacío = registro GLOBAL (propagación hasta 1h).
DISCORD_DEV_GUILD_ID=

# --- Bot: API HTTP (para que la web consulte canales de voz en los splits) ---
# Puerto donde el bot escucha el endpoint /api/voice.
BOT_API_PORT=3001
# Secreto compartido entre el bot y la web (Authorization: Bearer <secret>).
# Si no se setea, el endpoint de voz queda desactivado.
BOT_API_SECRET=
# URL interna con la que la WEB llega al endpoint del bot (ej: http://bot-host:3001).
BOT_INTERNAL_URL=

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
# Service role key: el BOT se salta RLS. NUNCA exponer en cliente/web.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key: la usa la web (cliente) con las políticas RLS.
SUPABASE_ANON_KEY=
# Conexiones directas a Postgres (solo para scripts/migraciones):
DATABASE_URL=
DIRECT_URL=

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stitch API (UI design, opcional) ---
STITCH_API_KEY=